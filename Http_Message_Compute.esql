CREATE COMPUTE MODULE Http_Message_Compute
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Extraer datos de entrada y guardarlos en Environment
        SET Environment.RequestEntrada = InputRoot.JSON.Data;
        
        -- Validar que los datos de entrada tengan formato correcto
        IF EXISTS(InputRoot.JSON.Data[]) THEN
            SET Environment.ValidationStatus = 'VALID';
        ELSE
            SET Environment.ValidationStatus = 'INVALID';
            --  crear un mensaje de error Pendiente 
        END IF;
        
        RETURN TRUE;
    END;
END MODULE;
CREATE COMPUTE MODULE CategoryToURLMapper
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Obtener la categoría del Environment
        DECLARE chcategory CHARACTER COALESCE(Environment.RequestEntrada.category, '');
        
        -- Tabla dinámica de categorías y URLs
        DECLARE categoryURLMap ROW;
        SET categoryURLMap.mens_clothing = 'https://fakestoreapi.com/products/category/men%27s%20clothing';
        SET categoryURLMap.womens_clothing = 'https://fakestoreapi.com/products/category/women%27s%20clothing';
        SET categoryURLMap.jewelery = 'https://fakestoreapi.com/products/category/jewelery';
        SET categoryURLMap.electronics = 'https://fakestoreapi.com/products/category/electronics';
        
        -- Buscar la URL según la categoría
        DECLARE targetURL CHARACTER;
        
            -- Verificar si la categoría existe en el mapa y asignar la URL correspondiente
        
        CASE chcategory
            WHEN 'mens_clothing' THEN
                SET targetURL = categoryURLMap.mens_clothing;
            WHEN 'womens_clothing' THEN
                SET targetURL = categoryURLMap.womens_clothing;
            WHEN 'jewelery' THEN
                SET targetURL = categoryURLMap.jewelery;
            WHEN 'electronics' THEN
                SET targetURL = categoryURLMap.electronics;
            ELSE
                SET targetURL = 'https://fakestoreapi.com/products';
        END CASE;
        
        -- Guardar la URL y la categoría original en Environment para uso posterior
        SET Environment.TargetURL = targetURL;
        SET Environment.OriginalCategory = chcategory;
        
        RETURN TRUE;
    END;
END MODULE;
CREATE COMPUTE MODULE ConfigureHTTPRequest
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Crear estructura de salida JSON
        CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
        CREATE FIELD OutputRoot.JSON.Data;
        
        -- Referencia al Environment local
        DECLARE refLocalEnv REFERENCE TO OutputLocalEnvironment;
        
        -- Configurar parámetros de la solicitud HTTP
        -- Usa la URL que fue determinada en el módulo anterior
        SET refLocalEnv.Destination.HTTP.RequestURL = Environment.TargetURL;
        SET refLocalEnv.Destination.HTTP.Timeout = 15;
        SET refLocalEnv.Destination.HTTP.RequestLine.Method = 'GET';
        
        RETURN TRUE;
    END;
END MODULE;