CREATE COMPUTE MODULE Http_Message_Compute
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Guardar los parámetros de filtrado en Environment
        SET Environment.RequestEntrada = InputRoot.JSON.Data;
        
        RETURN TRUE;
    END;
END MODULE;
CREATE COMPUTE MODULE Http_Consulta_Productos
   CREATE FUNCTION Main() RETURNS BOOLEAN
   BEGIN
      -- Obtener la categoría del Environment
      DECLARE chcategory CHARACTER COALESCE(Environment.RequestEntrada.category, '');
      
      -- Crear estructura de salida JSON
      CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
      CREATE FIELD OutputRoot.JSON.Data;
      
      -- Referencia al Environment local
      DECLARE refLocalEnv REFERENCE To OutputLocalEnvironment;
      
      -- Construir la URL correctamente
      IF chcategory = 'men''s clothing' THEN
         -- URL codificada manualmente para "men's clothing"
         SET refLocalEnv.Destination.HTTP.RequestURL = 'https://fakestoreapi.com/products/category/men%27s%20clothing';
      ELSEIF chcategory = 'women''s clothing' THEN
         -- URL codificada manualmente para "women's clothing"
         SET refLocalEnv.Destination.HTTP.RequestURL = 'https://fakestoreapi.com/products/category/women%27s%20clothing';
      ELSEIF chcategory = 'jewelery' THEN
         SET refLocalEnv.Destination.HTTP.RequestURL = 'https://fakestoreapi.com/products/category/jewelery';
      ELSEIF chcategory = 'electronics' THEN
         SET refLocalEnv.Destination.HTTP.RequestURL = 'https://fakestoreapi.com/products/category/electronics';
      ELSE
         -- Si no es una categoría conocida, obtener todos los productos
         SET refLocalEnv.Destination.HTTP.RequestURL = 'https://fakestoreapi.com/products';
      END IF;
      
      -- Configurar timeout y método
      SET refLocalEnv.Destination.HTTP.Timeout = 15;
      SET refLocalEnv.Destination.HTTP.RequestLine.Method = 'GET';
      
      -- Guardar la categoría original para uso posterior
      SET Environment.OriginalCategory = chcategory;
      
      RETURN TRUE;
   END;
END MODULE;

