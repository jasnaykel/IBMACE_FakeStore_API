CREATE COMPUTE MODULE Http_Message_Compute
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Extraer datos de entrada y guardarlos en Environment
        SET Environment.RequestEntrada = InputRoot.JSON.Data;
        
        -- Validar que los datos de entrada tengan formato correcto
        IF EXISTS(InputRoot.JSON.Data.requestType[]) AND
           EXISTS(InputRoot.JSON.Data.parameters[]) THEN
            SET Environment.ValidationStatus = 'VALID';
        ELSE
            SET Environment.ValidationStatus = 'INVALID';
            -- Crear un mensaje de error
            CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
            CREATE FIELD OutputRoot.JSON.Data;
            SET OutputRoot.JSON.Data.responseInfo.status = 'error';
            SET OutputRoot.JSON.Data.responseInfo.message = 'Invalid request format';
            SET OutputRoot.JSON.Data.responseInfo.timestamp = CURRENT_TIMESTAMP;
            RETURN FALSE;
        END IF;
        
        RETURN TRUE;
    END;
END MODULE;
CREATE COMPUTE MODULE CategoryToURLMapper
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Determinar qué operación SOAP invocar basado en el requestType y searchType
        DECLARE requestType CHARACTER COALESCE(Environment.RequestEntrada.requestType, '');
        DECLARE searchType CHARACTER COALESCE(Environment.RequestEntrada.parameters.searchType, '');
        
        -- Guardar la operación SOAP en el Environment para usarla más tarde
        IF requestType = 'countryInfo' THEN
            IF searchType = 'byCode' THEN
                SET Environment.SOAPOperation = 'FullCountryInfo';
                SET Environment.CountryCode = Environment.RequestEntrada.parameters.countryCode;
            ELSEIF searchType = 'byName' THEN
                SET Environment.SOAPOperation = 'CountryISOCode';
                SET Environment.CountryName = Environment.RequestEntrada.parameters.countryName;
            END IF;
        ELSEIF requestType = 'listCountries' THEN
            IF searchType = 'byCode' THEN
                SET Environment.SOAPOperation = 'ListOfCountryNamesByCode';
            ELSE
                SET Environment.SOAPOperation = 'ListOfCountryNamesByName';
            END IF;
        ELSEIF requestType = 'currencyInfo' THEN
            SET Environment.SOAPOperation = 'CurrencyName';
            SET Environment.CurrencyCode = Environment.RequestEntrada.parameters.currencyCode;
        ELSEIF requestType = 'countryLanguage' THEN
            SET Environment.SOAPOperation = 'ListOfLanguagesByName';
        END IF;
        
        RETURN TRUE;
    END;
END MODULE;
CREATE COMPUTE MODULE ConfigureHTTPRequest
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
      -- Guardar la operación SOAP en el Environment para usarla más tarde
        DECLARE requestType CHARACTER Environment.RequestEntrada.requestType;
        
        -- Determinar la operación SOAP basada en el tipo de solicitud
        IF requestType = 'countryInfo' AND Environment.RequestEntrada.parameters.searchType = 'byCode' THEN
            SET Environment.SOAPOperation = 'FullCountryInfo';
        ELSEIF requestType = 'countryInfo' AND Environment.RequestEntrada.parameters.searchType = 'byName' THEN
            SET Environment.SOAPOperation = 'CountryISOCode';
        ELSEIF requestType = 'listCountries' AND Environment.RequestEntrada.parameters.searchType = 'byCode' THEN
            SET Environment.SOAPOperation = 'ListOfCountryNamesByCode';
        ELSEIF requestType = 'listCountries' AND Environment.RequestEntrada.parameters.searchType = 'byName' THEN
            SET Environment.SOAPOperation = 'ListOfCountryNamesByName';
        ELSEIF requestType = 'currencyInfo' THEN
            SET Environment.SOAPOperation = 'CurrencyName';
        ELSEIF requestType = 'countryLanguage' THEN
            SET Environment.SOAPOperation = 'ListOfLanguagesByName';
        END IF;
        
        -- Crear estructura SOAP para la salida
        CREATE LASTCHILD OF OutputRoot DOMAIN 'XMLNSC';
        
        -- Crear el sobre SOAP con declaraciones de espacios de nombres correctas
        DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';
        DECLARE ns NAMESPACE 'http://www.oorsprong.org/websamples.countryinfo';
        
        -- Crear el sobre SOAP usando la sintaxis de espacio de nombres
        CREATE FIELD OutputRoot.XMLNSC.{soapenv}:Envelope;
        SET OutputRoot.XMLNSC.{soapenv}:Envelope.(XMLNSC.NamespaceDecl).soapenv = soapenv;
        SET OutputRoot.XMLNSC.{soapenv}:Envelope.(XMLNSC.NamespaceDecl).ns = ns;
        
        -- Crear el cuerpo SOAP
        CREATE FIELD OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body;
        
        -- Crear la solicitud SOAP según la operación
        IF Environment.SOAPOperation = 'FullCountryInfo' THEN
            CREATE FIELD OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:FullCountryInfo;
            SET OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:FullCountryInfo.{ns}:sCountryISOCode = 
                Environment.RequestEntrada.parameters.countryCode;
                
        ELSEIF Environment.SOAPOperation = 'CountryISOCode' THEN
            -- Guardar el nombre del país para usarlo más tarde
            SET Environment.CountryName = Environment.RequestEntrada.parameters.countryName;
            
            CREATE FIELD OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:CountryISOCode;
            SET OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:CountryISOCode.{ns}:sCountryName = 
                Environment.CountryName;
                
        ELSEIF Environment.SOAPOperation = 'ListOfCountryNamesByCode' THEN
            CREATE FIELD OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:ListOfCountryNamesByCode;
            
        ELSEIF Environment.SOAPOperation = 'ListOfCountryNamesByName' THEN
            CREATE FIELD OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:ListOfCountryNamesByName;
            
        ELSEIF Environment.SOAPOperation = 'CurrencyName' THEN
            -- Guardar el código de moneda para usarlo más tarde
            SET Environment.CurrencyCode = Environment.RequestEntrada.parameters.currencyCode;
            
            CREATE FIELD OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:CurrencyName;
            SET OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:CurrencyName.{ns}:sCurrencyISOCode = 
                Environment.CurrencyCode;
                
        ELSEIF Environment.SOAPOperation = 'ListOfLanguagesByName' THEN
            CREATE FIELD OutputRoot.XMLNSC.{soapenv}:Envelope.{soapenv}:Body.{ns}:ListOfLanguagesByName;
        END IF;
        
        -- Configurar parámetros de la solicitud SOAP
        SET OutputLocalEnvironment.Destination.SOAP.Request.Transport.HTTP.WebServiceURL = 
            'http://webservices.oorsprong.org/websamples.countryinfo/CountryInfoService.wso';
        SET OutputLocalEnvironment.Destination.SOAP.Request.Transport.HTTP.Timeout = 30;
        
        -- Configurar la operación SOAP en el entorno local
        SET OutputLocalEnvironment.Destination.SOAP.Request.Operation = Environment.SOAPOperation;
        
        RETURN TRUE;
    END;
END MODULE;