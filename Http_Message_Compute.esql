CREATE COMPUTE MODULE Http_Message_Compute
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Validar que los datos de entrada tengan formato correcto
        IF NOT EXISTS(InputRoot.JSON[]) THEN
            THROW USER EXCEPTION VALUES('JSON no encontrado');
        END IF;
          -- Extraer datos de entrada y guardarlos en Environment
        SET Environment.RequestEntrada = InputRoot.JSON.Data;
        RETURN TRUE;
    END;
END MODULE;
CREATE COMPUTE MODULE CategoryToURLMapper
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        DECLARE chcategory CHARACTER COALESCE(Environment.RequestEntrada.category, '');
        DECLARE price INTEGER COALESCE(Environment.RequestEntrada.price, 0);
        DECLARE baseURL CHARACTER 'https://fakestoreapi.com/products';
        DECLARE cleanCategory CHARACTER;
        DECLARE finalURL CHARACTER;
        
        IF LENGTH(chcategory) = 0 AND price > 0 THEN
            -- Solo precio: usar URL base para obtener todos los productos y filtrar después
            SET Environment.TargetURL = baseURL;
            SET Environment.OriginalCategory = '';
            RETURN TRUE;
        END IF;

        -- Limpiar y normalizar la categoría
        SET cleanCategory = chcategory;
        
        -- Validar solo categorías exactas de la API
        IF cleanCategory NOT IN ('men''s clothing', 'women''s clothing', 'jewelery', 'electronics') THEN
            THROW USER EXCEPTION VALUES('Invalid category. Valid categories are: men''s clothing, women''s clothing, jewelery, electronics');
        END IF;
        
        -- Codificación manual más confiable que URLENCODE()
        CASE cleanCategory
            WHEN 'men''s clothing' THEN
                SET finalURL = baseURL || '/category/men%27s%20clothing';
            WHEN 'women''s clothing' THEN
                SET finalURL = baseURL || '/category/women%27s%20clothing';
            WHEN 'jewelery' THEN
                SET finalURL = baseURL || '/category/jewelery';
            WHEN 'electronics' THEN
                SET finalURL = baseURL || '/category/electronics';
            ELSE
                SET finalURL = baseURL;
        END CASE;
        
        -- Asignar valores finales
        SET Environment.TargetURL = finalURL;
        SET Environment.OriginalCategory = cleanCategory;
        
        RETURN TRUE;
    END;
END MODULE;
CREATE COMPUTE MODULE ConfigureHTTPRequest
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Crear estructura de salida JSON vacía
        CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
        CREATE FIELD OutputRoot.JSON.Data;
        
        -- Configurar parámetros de la solicitud HTTP
        SET OutputLocalEnvironment.Destination.HTTP.RequestURL = Environment.TargetURL;
        SET OutputLocalEnvironment.Destination.HTTP.Timeout = 15;
        SET OutputLocalEnvironment.Destination.HTTP.RequestLine.Method = 'GET';
        
        RETURN TRUE;
    END;
END MODULE;
CREATE COMPUTE MODULE FilterProductsByPrice
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Copiar propiedades
        SET OutputRoot.Properties = InputRoot.Properties;
        
        -- Crear estructura JSON para la salida
        CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
        CREATE FIELD OutputRoot.JSON.Data;
        
        -- Verificar si hay un precio especificado
        IF EXISTS(Environment.RequestEntrada.price[]) THEN
            DECLARE targetPrice INTEGER Environment.RequestEntrada.price;
            DECLARE found BOOLEAN FALSE;
            
            -- Crear una referencia al primer elemento de datos
            DECLARE dataRef REFERENCE TO InputRoot.JSON.Data;
            
            IF EXISTS(dataRef.Item[]) THEN
                -- Estructura con Items numerados
                DECLARE i INTEGER 1;
                DECLARE j INTEGER 1;
                
                -- Crear una referencia al primer Item
                DECLARE itemRef REFERENCE TO dataRef.Item[i];
                
                -- Usar LASTMOVE correctamente con la referencia
                WHILE LASTMOVE(itemRef) DO
                    IF itemRef.price = targetPrice THEN
                        -- Copia  item que coincid
                        SET OutputRoot.JSON.Data.Item[j].id = itemRef.id;
                        SET OutputRoot.JSON.Data.Item[j].title = itemRef.title;
                        SET OutputRoot.JSON.Data.Item[j].price = itemRef.price;
                        SET OutputRoot.JSON.Data.Item[j].description = itemRef.description;
                        SET OutputRoot.JSON.Data.Item[j].category = itemRef.category;
                        SET OutputRoot.JSON.Data.Item[j].image = itemRef.image;
                        -- Copiar rating preservando formato
                        SET OutputRoot.JSON.Data.Item[j].rating.rate = CAST(itemRef.rating.rate AS DECIMAL);
                        SET OutputRoot.JSON.Data.Item[j].rating.count = itemRef.rating.count;
                        SET j = j + 1;
                        SET found = TRUE;
                    END IF;
                    
                    SET i = i + 1;
                    MOVE itemRef TO dataRef.Item[i];
                END WHILE;
            ELSEIF CARDINALITY(dataRef.*[]) > 0 THEN
                DECLARE j INTEGER 1;
                
                FOR arrayItem AS dataRef.*[] DO
                    IF arrayItem.price = targetPrice THEN
                        -- Copiar el item que coincide
                        SET OutputRoot.JSON.Data.Item[j] = arrayItem;
                        SET j = j + 1;
                        SET found = TRUE;
                    END IF;
                END FOR;
            END IF;
            
            IF NOT found THEN --message
                SET OutputRoot.JSON.Data.message = 'No products found with price ' || CAST(targetPrice AS CHARACTER);
            END IF;
  
        END IF;
        
        RETURN TRUE;
    END;
END MODULE;