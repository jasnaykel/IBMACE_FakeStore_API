CREATE COMPUTE MODULE TransformSOAPtoJSON
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
        -- Verificar si hay un error en Environment
        IF EXISTS(Environment.Error[]) THEN
            -- Si ya hay un error configurado, no hacer nada y dejar que el manejador de errores lo procese
            RETURN FALSE;
        END IF;
        
        -- Verificar si hay una respuesta SOAP válida
        IF NOT EXISTS(InputRoot.SOAP.Body[]) AND NOT EXISTS(InputRoot.XMLNSC[]) THEN
            SET Environment.Error.Type = 'SOAPError';
            SET Environment.Error.Message = 'Respuesta SOAP vacía o inválida';
            RETURN FALSE;
        END IF;
		-- Crear estructura JSON para la salida
		CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
		CREATE FIELD OutputRoot.JSON.Data;
		-- Información de respuesta estándar
		SET OutputRoot.JSON.Data.responseInfo.status = 'success';
		SET OutputRoot.JSON.Data.responseInfo.timestamp = CURRENT_TIMESTAMP;
		-- Determinar el tipo de solicitud
		DECLARE requestType CHARACTER '';
		IF EXISTS(Environment.RequestEntrada.requestType[]) THEN
			SET requestType = Environment.RequestEntrada.requestType;
		END IF;
		-- Procesar según el tipo de solicitud
		CASE requestType
		WHEN 'countryInfo' THEN
			CALL ProcessCountryInfo();
		WHEN 'listCountries' THEN
			CALL ProcessListCountries();
        WHEN 'currencyInfo' THEN
			CALL ProcessCurrencyInfo();
        WHEN 'countryLanguage' THEN
			CALL ProcessCountryLanguage();
        WHEN 'capitalCity' THEN
			CALL ProcessCapitalCity();
		ELSE
			SET OutputRoot.JSON.Data.error.message = 'Tipo de solicitud no soportado: ' || requestType;
		END CASE;
        -- Verificar si se generó un error durante el procesamiento
        IF EXISTS(OutputRoot.JSON.Data.error[]) THEN
            -- Convertir el error interno en un error de Environment para el manejador
            SET Environment.Error.Type = 'SOAPError';
            SET Environment.Error.Message = COALESCE(OutputRoot.JSON.Data.error.message, 'Error al procesar la respuesta SOAP');
            RETURN FALSE;
        END IF;
        
        -- Configurar el código de respuesta HTTP
        SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 200;
		RETURN TRUE;
	END;

	CREATE PROCEDURE ProcessCountryInfo() 
    BEGIN
		-- Definir espacios de nombres
		DECLARE ns NAMESPACE 'http://www.oorsprong.org/websamples.countryinfo';
		-- Extraer datos del país de la respuesta SOAP
		IF EXISTS(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult[]) THEN
			-- Extraer datos básicos
			SET OutputRoot.JSON.Data.countryData.basicInfo.code =
			CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sISOCode AS CHARACTER);
			SET OutputRoot.JSON.Data.countryData.basicInfo.name =
			CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sName AS CHARACTER);
			SET OutputRoot.JSON.Data.countryData.basicInfo.capital =
			CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sCapitalCity AS CHARACTER);
			-- Extraer detalles
			SET OutputRoot.JSON.Data.countryData.details.phoneCode =
			CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sPhoneCode AS CHARACTER);
			SET OutputRoot.JSON.Data.countryData.details.continent.code =
			CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sContinentCode AS CHARACTER);
			SET OutputRoot.JSON.Data.countryData.details.currency.code =
			CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sCurrencyISOCode AS CHARACTER);
			SET OutputRoot.JSON.Data.countryData.details.flagUrl =
			CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sCountryFlag AS CHARACTER);
			-- Extraer información del idioma si existe
			IF EXISTS(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:Languages.ns:tLanguage[]) THEN
				SET OutputRoot.JSON.Data.countryData.details.language.code =
				CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:Languages.ns:tLanguage.ns:sISOCode AS CHARACTER);
				SET OutputRoot.JSON.Data.countryData.details.language.name =
				CAST(InputRoot.SOAP.Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:Languages.ns:tLanguage.ns:sName AS CHARACTER);
			END IF;
		ELSE
			-- Intentar con estructura alternativa (XMLNSC)
			DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';

			IF EXISTS(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult[]) THEN
				-- Extraer datos básicos
				SET OutputRoot.JSON.Data.countryData.basicInfo.code =
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sISOCode AS CHARACTER);
				SET OutputRoot.JSON.Data.countryData.basicInfo.name =
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sName AS CHARACTER);
				SET OutputRoot.JSON.Data.countryData.basicInfo.capital =
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sCapitalCity AS CHARACTER);
				-- Extraer detalles
				SET OutputRoot.JSON.Data.countryData.details.phoneCode =
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sPhoneCode AS CHARACTER);
				SET OutputRoot.JSON.Data.countryData.details.continent.code =
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sContinentCode AS CHARACTER);
				SET OutputRoot.JSON.Data.countryData.details.currency.code =
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sCurrencyISOCode AS CHARACTER);
				SET OutputRoot.JSON.Data.countryData.details.flagUrl =
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:sCountryFlag AS CHARACTER);
				-- Extraer información del idioma si existe
				IF EXISTS(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:Languages.ns:tLanguage[]) THEN
					SET OutputRoot.JSON.Data.countryData.details.language.code =
					CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:Languages.ns:tLanguage.ns:sISOCode AS CHARACTER);
					SET OutputRoot.JSON.Data.countryData.details.language.name =
					CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:FullCountryInfoResponse.ns:FullCountryInfoResult.ns:Languages.ns:tLanguage.ns:sName AS CHARACTER);
				END IF;
			ELSE
				-- Si no se encuentra la estructura esperada, proporcionar información de depuración
				SET OutputRoot.JSON.Data.error.message = 'No se pudo encontrar la estructura esperada en la respuesta SOAP';
				SET OutputRoot.JSON.Data.error.availableDomains = '';

				IF EXISTS(InputRoot.SOAP[]) THEN
					SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' SOAP';
				END IF;

				IF EXISTS(InputRoot.XMLNSC[]) THEN
					SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' XMLNSC';
				END IF;

				IF EXISTS(InputRoot.SOAP_Domain_Msg[]) THEN
					SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' SOAP_Domain_Msg';
				END IF;
			END IF;
		END IF;
	END;

	CREATE PROCEDURE ProcessListCountries() BEGIN
		-- Definir espacios de nombres
		DECLARE ns NAMESPACE 'http://www.oorsprong.org/websamples.countryinfo';
		DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';
		DECLARE searchType CHARACTER '';
		-- Obtener el tipo de búsqueda
		IF EXISTS(Environment.RequestEntrada.parameters.searchType[]) THEN
			SET searchType = Environment.RequestEntrada.parameters.searchType;
		END IF;
		-- Procesar según el tipo de búsqueda
		CASE searchType
		WHEN 'byCode' THEN
			-- Extraer lista de países de la respuesta SOAP (ordenados por código)
			IF EXISTS(InputRoot.SOAP.Body.ns:ListOfCountryNamesByCodeResponse.ns:ListOfCountryNamesByCodeResult[]) THEN
				-- Referencia al array de países
				DECLARE countriesRef REFERENCE TO InputRoot.SOAP.Body.ns:ListOfCountryNamesByCodeResponse.ns:ListOfCountryNamesByCodeResult;
				CALL ProcessCountryList(countriesRef);
			ELSEIF EXISTS(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:ListOfCountryNamesByCodeResponse.ns:ListOfCountryNamesByCodeResult[]) THEN
				-- Referencia al array de países
				DECLARE countriesRef REFERENCE TO InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:ListOfCountryNamesByCodeResponse.ns:ListOfCountryNamesByCodeResult;
				CALL ProcessCountryList(countriesRef);
			ELSE
				SET OutputRoot.JSON.Data.error.message = 'No se pudo encontrar la estructura esperada para la lista de países por código';
				SET OutputRoot.JSON.Data.error.searchType = searchType;
			END IF;
		WHEN 'byName' THEN
			-- Extraer lista de países de la respuesta SOAP (ordenados por nombre)
			IF EXISTS(InputRoot.SOAP.Body.ns:ListOfCountryNamesByNameResponse.ns:ListOfCountryNamesByNameResult[]) THEN
				-- Referencia al array de países
				DECLARE countriesRef REFERENCE TO InputRoot.SOAP.Body.ns:ListOfCountryNamesByNameResponse.ns:ListOfCountryNamesByNameResult;
				CALL ProcessCountryList(countriesRef);
			ELSEIF EXISTS(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:ListOfCountryNamesByNameResponse.ns:ListOfCountryNamesByNameResult[]) THEN
				-- Referencia al array de países
				DECLARE countriesRef REFERENCE TO InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:ListOfCountryNamesByNameResponse.ns:ListOfCountryNamesByNameResult;
				CALL ProcessCountryList(countriesRef);
			ELSE
				SET OutputRoot.JSON.Data.error.message = 'No se pudo encontrar la estructura esperada para la lista de países por nombre';
				SET OutputRoot.JSON.Data.error.searchType = searchType;
			END IF;
		ELSE
			-- Tipo de búsqueda no soportado o no especificado
			SET OutputRoot.JSON.Data.error.message = 'Tipo de búsqueda no soportado o no especificado';
			SET OutputRoot.JSON.Data.error.searchType = searchType;
		END CASE;
		-- Si no se encontró la estructura esperada, proporcionar información de depuración
		IF EXISTS(OutputRoot.JSON.Data.error[]) AND NOT EXISTS(OutputRoot.JSON.Data.countries[]) THEN
			SET OutputRoot.JSON.Data.error.availableDomains = '';

			IF EXISTS(InputRoot.SOAP[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' SOAP';
			END IF;

			IF EXISTS(InputRoot.XMLNSC[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' XMLNSC';
			END IF;

			IF EXISTS(InputRoot.SOAP_Domain_Msg[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' SOAP_Domain_Msg';
			END IF;
		END IF;
	END;

	CREATE PROCEDURE ProcessCountryList(IN countriesRef REFERENCE) BEGIN
		DECLARE i INTEGER 1;
		DECLARE countryCount INTEGER 0;
		DECLARE ns NAMESPACE 'http://www.oorsprong.org/websamples.countryinfo';
		DECLARE countryListRef REFERENCE TO countriesRef;
		-- Inicializar el array de países en la respuesta JSON
		CREATE FIELD OutputRoot.JSON.Data.countries;
		CREATE FIELD OutputRoot.JSON.Data.countries.items;
		-- Verificar si existen países
		IF EXISTS(countriesRef.ns:tCountryCodeAndName[]) THEN
			-- Iterar a través de todos los países
			MOVE countryListRef TO countriesRef;
			-- Usar un bucle FOR para iterar a través de los países
			FOR countryItem AS countryListRef.ns:tCountryCodeAndName[] DO
				-- Extraer código y nombre del país
				SET OutputRoot.JSON.Data.countries.items[i].code = CAST(countryItem.ns:sISOCode AS CHARACTER);
				SET OutputRoot.JSON.Data.countries.items[i].name = CAST(countryItem.ns:sName AS CHARACTER);

				SET countryCount = countryCount + 1;
				SET i = i + 1;
			END FOR;
		END IF;
		-- Establecer el contador de países
		SET OutputRoot.JSON.Data.countries.count = countryCount;
	END;
    CREATE PROCEDURE ProcessCurrencyInfo() BEGIN
		-- Definir espacios de nombres
		DECLARE ns NAMESPACE 'http://www.oorsprong.org/websamples.countryinfo';
		DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';
		
		-- Extraer información de moneda de la respuesta SOAP
		IF EXISTS(InputRoot.SOAP.Body.ns:CurrencyNameResponse.ns:CurrencyNameResult[]) THEN
			-- Extraer el nombre de la moneda
			SET OutputRoot.JSON.Data.currencyData.code = Environment.CurrencyCode;
			SET OutputRoot.JSON.Data.currencyData.name = 
				CAST(InputRoot.SOAP.Body.ns:CurrencyNameResponse.ns:CurrencyNameResult AS CHARACTER);
		ELSEIF EXISTS(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:CurrencyNameResponse.ns:CurrencyNameResult[]) THEN
			-- Extraer el nombre de la moneda (estructura alternativa)
			SET OutputRoot.JSON.Data.currencyData.code = Environment.CurrencyCode;
			SET OutputRoot.JSON.Data.currencyData.name = 
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:CurrencyNameResponse.ns:CurrencyNameResult AS CHARACTER);
		ELSE
			-- Si no se encuentra la estructura esperada, proporcionar información de depuración
			SET OutputRoot.JSON.Data.error.message = 'No se pudo encontrar la información de moneda en la respuesta SOAP';
			SET OutputRoot.JSON.Data.error.availableDomains = '';

			IF EXISTS(InputRoot.SOAP[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' SOAP';
			END IF;

			IF EXISTS(InputRoot.XMLNSC[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' XMLNSC';
			END IF;
		END IF;
        END;
        -- transformacion para procesar inf sobre los idiomas de un paiss 
        CREATE PROCEDURE ProcessCountryLanguage() BEGIN
		-- Definir espacios de nombres
		DECLARE ns NAMESPACE 'http://www.oorsprong.org/websamples.countryinfo';
		DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';
		
		-- Extraer información de idiomas del país de la respuesta SOAP
		IF EXISTS(InputRoot.SOAP.Body.ns:ListOfLanguagesByNameResponse.ns:ListOfLanguagesByNameResult[]) THEN
			-- Referencia al array de idiomas
			DECLARE languagesRef REFERENCE TO InputRoot.SOAP.Body.ns:ListOfLanguagesByNameResponse.ns:ListOfLanguagesByNameResult;
			CALL ProcessLanguageList(languagesRef);
		ELSEIF EXISTS(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:ListOfLanguagesByNameResponse.ns:ListOfLanguagesByNameResult[]) THEN
			-- Referencia al array de idiomas (estructura alternativa)
			DECLARE languagesRef REFERENCE TO InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:ListOfLanguagesByNameResponse.ns:ListOfLanguagesByNameResult;
			CALL ProcessLanguageList(languagesRef);
		ELSE
			-- Si no se encuentra la estructura esperada, proporcionar información de depuración
			SET OutputRoot.JSON.Data.error.message = 'No se pudo encontrar la información de idiomas en la respuesta SOAP';
			SET OutputRoot.JSON.Data.error.availableDomains = '';

			IF EXISTS(InputRoot.SOAP[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' SOAP';
			END IF;

			IF EXISTS(InputRoot.XMLNSC[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' XMLNSC';
			END IF;
		END IF;
	END;
	
	CREATE PROCEDURE ProcessLanguageList(IN languagesRef REFERENCE) BEGIN
		DECLARE i INTEGER 1;
		DECLARE languageCount INTEGER 0;
		DECLARE ns NAMESPACE 'http://www.oorsprong.org/websamples.countryinfo';
		DECLARE languageListRef REFERENCE TO languagesRef;
		
		-- Inicializar el array de idiomas en la respuesta JSON
		CREATE FIELD OutputRoot.JSON.Data.languages;
		CREATE FIELD OutputRoot.JSON.Data.languages.items;
		
		-- Verificar si existen idiomas
		IF EXISTS(languagesRef.ns:tLanguage[]) THEN
			-- Iterar a través de todos los idiomas
			MOVE languageListRef TO languagesRef;
			
			-- Usar un bucle FOR para iterar a través de los idiomas
			FOR languageItem AS languageListRef.ns:tLanguage[] DO
				-- Extraer código y nombre del idioma
				SET OutputRoot.JSON.Data.languages.items[i].code = CAST(languageItem.ns:sISOCode AS CHARACTER);
				SET OutputRoot.JSON.Data.languages.items[i].name = CAST(languageItem.ns:sName AS CHARACTER);
				
				SET languageCount = languageCount + 1;
				SET i = i + 1;
			END FOR;
		END IF;
		
		-- Establecer el contador de idiomas
		SET OutputRoot.JSON.Data.languages.count = languageCount;
	END;
    CREATE PROCEDURE ProcessCapitalCity() BEGIN
		-- Definir espacios de nombres
		DECLARE ns NAMESPACE 'http://www.oorsprong.org/websamples.countryinfo';
		DECLARE soapenv NAMESPACE 'http://schemas.xmlsoap.org/soap/envelope/';
		
		-- Extraer información de la capital del país de la respuesta SOAP
		IF EXISTS(InputRoot.SOAP.Body.ns:CapitalCityResponse.ns:CapitalCityResult[]) THEN
			-- Extraer el nombre de la capital
			SET OutputRoot.JSON.Data.capitalInfo.countryCode = Environment.CountryCode;
			SET OutputRoot.JSON.Data.capitalInfo.capitalName = 
				CAST(InputRoot.SOAP.Body.ns:CapitalCityResponse.ns:CapitalCityResult AS CHARACTER);
		ELSEIF EXISTS(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:CapitalCityResponse.ns:CapitalCityResult[]) THEN
			-- Extraer el nombre de la capital (estructura alternativa)
			SET OutputRoot.JSON.Data.capitalInfo.countryCode = Environment.CountryCode;
			SET OutputRoot.JSON.Data.capitalInfo.capitalName = 
				CAST(InputRoot.XMLNSC.soapenv:Envelope.soapenv:Body.ns:CapitalCityResponse.ns:CapitalCityResult AS CHARACTER);
		ELSE
			-- Si no se encuentra la estructura esperada, proporcionar información de depuración
			SET OutputRoot.JSON.Data.error.message = 'No se pudo encontrar la información de la capital en la respuesta SOAP';
			SET OutputRoot.JSON.Data.error.availableDomains = '';

			IF EXISTS(InputRoot.SOAP[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' SOAP';
			END IF;

			IF EXISTS(InputRoot.XMLNSC[]) THEN
				SET OutputRoot.JSON.Data.error.availableDomains = OutputRoot.JSON.Data.error.availableDomains || ' XMLNSC';
			END IF;
		END IF;
	END;

END MODULE;