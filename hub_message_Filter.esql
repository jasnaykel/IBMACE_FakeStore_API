
CREATE FILTER MODULE hub_message_Filter
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        -- Verificar si hay un error en Environment
        IF EXISTS(Environment.Error[]) THEN
            -- Si hay un error, devolver FALSE para ir al flujo de error
            RETURN FALSE;
        END IF;
        
        -- Devuelve TRUE si hay un precio especificado en la solicitud
        -- O si es una solicitud para el servicio CountryInfo
        RETURN EXISTS(Environment.RequestEntrada.price[]) OR 
               EXISTS(Environment.RequestEntrada.requestType[]) AND 
               (Environment.RequestEntrada.requestType = 'countryInfo' OR 
                Environment.RequestEntrada.requestType = 'listCountries' OR 
                Environment.RequestEntrada.requestType = 'currencyInfo' OR 
                Environment.RequestEntrada.requestType = 'countryLanguage' OR 
                Environment.RequestEntrada.requestType = 'capitalCity');
                
    END;
END MODULE;