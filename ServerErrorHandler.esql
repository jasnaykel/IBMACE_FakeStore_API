CREATE COMPUTE MODULE ImprovedErrorHandler
    CREATE FUNCTION Main() RETURNS BOOLEAN
    BEGIN
        DECLARE errorCode INTEGER;
        DECLARE errorStatus CHARACTER;
        DECLARE errorMessage CHARACTER;
        DECLARE errorDetail CHARACTER;
        DECLARE refToException REFERENCE TO InputExceptionList;
        DECLARE exceptionFound BOOLEAN FALSE;
        
        -- Verificar si hay un parámetro de prueba de error
        DECLARE testErrorCode CHARACTER;
        SET testErrorCode = InputLocalEnvironment.HTTP.Input.QueryString.errorCode;
        
        IF testErrorCode IS NOT NULL THEN
            -- Si se proporciona un código de error de prueba, úsalo
            SET errorCode = CAST(testErrorCode AS INTEGER);
            SET exceptionFound = TRUE;
        ELSE
            -- Primero verificar si hay un error tipificado en Environment
            IF EXISTS(Environment.Error[]) THEN
                SET exceptionFound = TRUE;
                
                -- Mapear tipos de error a códigos HTTP
                CASE Environment.Error.Type
                    WHEN 'ValidationError' THEN
                        SET errorCode = 400;
                        SET errorDetail = COALESCE(Environment.Error.Message, 'Error de validación');
                    WHEN 'NotFoundError' THEN
                        SET errorCode = 404;
                        SET errorDetail = COALESCE(Environment.Error.Message, 'Recurso no encontrado');
                    WHEN 'TimeoutError' THEN
                        SET errorCode = 504;
                        SET errorDetail = COALESCE(Environment.Error.Message, 'Tiempo de espera agotado');
                    WHEN 'SOAPError' THEN
                        SET errorCode = 502;
                        SET errorDetail = COALESCE(Environment.Error.Message, 'Error en servicio SOAP');
                    WHEN 'ServiceUnavailableError' THEN
                        SET errorCode = 503;
                        SET errorDetail = COALESCE(Environment.Error.Message, 'Servicio no disponible');
                    WHEN 'InternalError' THEN
                        SET errorCode = 500;
                        SET errorDetail = COALESCE(Environment.Error.Message, 'Error interno del servidor');
                    ELSE
                        SET errorCode = 500;
                        SET errorDetail = COALESCE(Environment.Error.Message, 'Error desconocido');
                END CASE;
            ELSE
                -- Buscar excepciones en el mensaje
                MOVE refToException TO InputExceptionList.[1];
                IF LASTMOVE(refToException) THEN
                    SET exceptionFound = TRUE;
                    
                    -- Extraer información de la excepción
                    SET errorCode = COALESCE(refToException.Number, 500);
                    SET errorDetail = COALESCE(refToException.Text, '');
                    
                    -- Verificar si es un error de ruta no encontrada
                    IF CONTAINS(errorDetail, 'not found') OR CONTAINS(errorDetail, 'No route') THEN
                        SET errorCode = 404;
                    -- Verificar si es un error de JSON
                    ELSEIF CONTAINS(errorDetail, 'JSON') THEN
                        SET errorCode = 400;
                    -- Verificar si es un error de timeout
                    ELSEIF CONTAINS(errorDetail, 'timeout') OR CONTAINS(errorDetail, 'timed out') THEN
                        SET errorCode = 504;
                    -- Verificar si es un error de SOAP
                    ELSEIF CONTAINS(errorDetail, 'SOAP') OR CONTAINS(errorDetail, 'web service') THEN
                        SET errorCode = 502;
                    END IF;
                ELSE
                    -- Verificar si es un error de ruta desde el entorno
                    IF InputLocalEnvironment.HTTP.Input.Path IS NOT NULL AND 
                       (InputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 404 OR 
                        CONTAINS(InputLocalEnvironment.HTTP.Input.Path, 'recurso_inexistente')) THEN
                        SET errorCode = 404;
                        SET exceptionFound = TRUE;
                    ELSE
                        SET errorCode = 500;
                    END IF;
                END IF;
            END IF;
        END IF;
        
        -- Mapear códigos de error a mensajes apropiados
        CASE errorCode
            WHEN 400 THEN
                SET errorStatus = 'BadRequest';
                SET errorMessage = 'Solicitud incorrecta';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 400;
            WHEN 401 THEN
                SET errorStatus = 'Unauthorized';
                SET errorMessage = 'No autorizado';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 401;
            WHEN 403 THEN
                SET errorStatus = 'Forbidden';
                SET errorMessage = 'Acceso prohibido';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 403;
            WHEN 404 THEN
                SET errorStatus = 'NotFound';
                SET errorMessage = 'Recurso no encontrado';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 404;
            WHEN 405 THEN
                SET errorStatus = 'MethodNotAllowed';
                SET errorMessage = 'Método no permitido';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 405;
            WHEN 429 THEN
                SET errorStatus = 'TooManyRequests';
                SET errorMessage = 'Demasiadas solicitudes';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 429;
            WHEN 502 THEN
                SET errorStatus = 'BadGateway';
                SET errorMessage = 'Error en servicio externo';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 502;
            WHEN 503 THEN
                SET errorStatus = 'ServiceUnavailable';
                SET errorMessage = 'Servicio no disponible';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 503;
            WHEN 504 THEN
                SET errorStatus = 'GatewayTimeout';
                SET errorMessage = 'Tiempo de espera agotado';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 504;
            ELSE
                -- Error 500 por defecto u otros errores no especificados
                SET errorCode = 500;
                SET errorStatus = 'InternalServerError';
                SET errorMessage = 'Error interno del servidor';
                SET OutputLocalEnvironment.Destination.HTTP.ReplyStatusCode = 500;
        END CASE;
        
        -- Crear respuesta JSON con información del error
        CREATE LASTCHILD OF OutputRoot DOMAIN 'JSON';
        CREATE FIELD OutputRoot.JSON.Data;
        
        -- Estructura de error
        SET OutputRoot.JSON.Data.error.code = errorCode;
        SET OutputRoot.JSON.Data.error.status = errorStatus;
        SET OutputRoot.JSON.Data.error.message = errorMessage;
        
        -- Solo incluir detalles en entorno de desarrollo o si es relevante
        IF errorDetail IS NOT NULL AND errorDetail <> '' THEN
            SET OutputRoot.JSON.Data.error.detail = errorDetail;
        END IF;
        
        SET OutputRoot.JSON.Data.error.timestamp = CURRENT_TIMESTAMP;
        
        -- Asegurar que los headers estén configurados correctamente
        SET OutputLocalEnvironment.Destination.HTTP.Headers."Content-Type" = 'application/json';
        
        RETURN TRUE;
    END;
END MODULE;